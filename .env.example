# Supabase — keep the service role key server-side only
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini — optional until AI analysis is enabled
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Public deployment URL used by SEO metadata
NEXT_PUBLIC_SITE_URL=

# Full deployed Infera URL used by GitHub Actions
# Add the same value as the GitHub repository secret INFERA_URL
INFERA_INGEST_URL=
